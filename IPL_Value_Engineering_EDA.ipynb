# ==============================================================================
# 1. IMPORTS & DEPENDENCIES
# ==============================================================================
import pandas as pd
import numpy as np
from difflib import get_close_matches
import plotly.express as px

print("⏳ Loading datasets...")

# ==============================================================================
# 2. DATA INGESTION
# ==============================================================================
# Ensure these files are uploaded to your Colab session before running
match_df = pd.read_csv('ipl_extracted/processed_ipl_data2.csv', low_memory=False)
auction_df = pd.read_csv('ipl_extracted/IPL_2024_Players_Auction_Dataset.csv')

# ==============================================================================
# 3. ON-FIELD PERFORMANCE AGGREGATION (2024)
# ==============================================================================
print("⚙️ Aggregating on-field performance metrics...")
match_df['season'] = pd.to_numeric(match_df['season'], errors='coerce')
match_2024 = match_df[match_df['season'] == 2024].copy()

# Batter Runs
player_runs = match_2024.groupby('batter', dropna=False)['batsman_runs'].sum().reset_index()
player_runs = player_runs.rename(columns={'batter': 'player_name', 'batsman_runs': 'Total Runs Scored'})

# Bowler Wickets
player_wickets = match_2024[match_2024['is_wicket'] == True].groupby('player_dismissed', dropna=False)['is_wicket'].sum().reset_index()
player_wickets = player_wickets.rename(columns={'player_dismissed': 'player_name', 'is_wicket': 'Total Wickets Taken'})

# Merge Performance
player_perf = pd.merge(player_runs, player_wickets, on='player_name', how='outer')
player_perf['Total Runs Scored'] = pd.to_numeric(player_perf['Total Runs Scored'], errors='coerce').fillna(0)
player_perf['Total Wickets Taken'] = pd.to_numeric(player_perf['Total Wickets Taken'], errors='coerce').fillna(0)

# ==============================================================================
# 4. FUZZY STRING MATCHING (Bridging Match Data with Auction Data)
# ==============================================================================
print("🔍 Executing fuzzy matching for player names...")
auction_df['Players'] = auction_df['Players'].astype(str).str.strip()
player_perf['player_name'] = player_perf['player_name'].astype(str).str.strip()
auction_names = auction_df['Players'].tolist()

# Match names with a 60% similarity threshold
player_perf['auction_player_name'] = player_perf['player_name'].apply(
    lambda name: get_close_matches(name, auction_names, n=1, cutoff=0.6)[0] 
    if get_close_matches(name, auction_names, n=1, cutoff=0.6) else None
)

merged_df = player_perf.merge(auction_df, left_on='auction_player_name', right_on='Players', how='left')

# ==============================================================================
# 5. FINANCIAL FEATURE ENGINEERING (The Value Metrics)
# ==============================================================================
print("📈 Calculating Value Engineering ROI metrics...")
auction_paid = merged_df.copy()
auction_paid['Team'] = auction_paid['Team'].astype(str)
auction_paid['TYPE'] = auction_paid['TYPE'].astype(str)

# Filter out Unsold and Unknown players
auction_paid = auction_paid[~auction_paid['TYPE'].str.upper().eq('UNKNOWN')].copy()
auction_paid = auction_paid[~auction_paid['Team'].str.upper().isin(['UNSOLD'])].copy()

# Convert Cost to raw Rupees
auction_paid['Sold Price (Rs)'] = pd.to_numeric(auction_paid['COST IN ₹ (CR.)'], errors='coerce') * 10000000
auction_paid = auction_paid[auction_paid['Sold Price (Rs)'].fillna(0) > 0].copy()

# Calculate Efficiencies
auction_paid['Cost Per Run'] = auction_paid['Sold Price (Rs)'] / auction_paid['Total Runs Scored'].replace(0, np.nan)
auction_paid['Cost Per Wicket'] = auction_paid['Sold Price (Rs)'] / auction_paid['Total Wickets Taken'].replace(0, np.nan)
auction_paid['Runs Per Crore'] = auction_paid['Total Runs Scored'] / (auction_paid['Sold Price (Rs)'] / 10000000).replace(0, np.nan)
auction_paid['Wickets Per Crore'] = auction_paid['Total Wickets Taken'] / (auction_paid['Sold Price (Rs)'] / 10000000).replace(0, np.nan)

# Composite Score (1 Wicket = 20 Runs roughly)
auction_paid['Total Contributions'] = auction_paid['Total Runs Scored'] + auction_paid['Total Wickets Taken'] * 20
auction_paid['Contribution Per Crore'] = auction_paid['Total Contributions'] / (auction_paid['Sold Price (Rs)'] / 10000000).replace(0, np.nan)

# Save the final cleaned CSV for the Streamlit App
auction_paid.to_csv('cleaned_ipl_metrics_2024.csv', index=False)
print("✅ Pipeline Complete! Data exported to 'cleaned_ipl_metrics_2024.csv'.")

# ==============================================================================
# 6. LEADERBOARDS & PRINT OUTPUTS
# ==============================================================================
print("\n🏆 TOP 5 UNDERVALUED BATSMEN:")
batsmen_top5_paid = auction_paid[(auction_paid['Total Runs Scored'] >= 150) & (auction_paid['Cost Per Run'].notna())].sort_values(['Cost Per Run', 'Total Runs Scored'], ascending=[True, False]).head(5)
display(batsmen_top5_paid[['player_name', 'Team', 'Cost Per Run', 'Total Runs Scored']])

print("\n🏆 TOP 5 UNDERVALUED BOWLERS:")
bowlers_top5_paid = auction_paid[(auction_paid['Total Wickets Taken'] >= 10) & (auction_paid['Cost Per Wicket'].notna())].sort_values(['Cost Per Wicket', 'Total Wickets Taken'], ascending=[True, False]).head(5)
display(bowlers_top5_paid[['player_name', 'Team', 'Cost Per Wicket', 'Total Wickets Taken']])

# ==============================================================================
# 7. VISUALIZATION (Plotly Scatter Plot)
# ==============================================================================
batsmen_df = auction_paid[(auction_paid['Total Runs Scored'] > 0) & (auction_paid['Sold Price (Rs)'] > 0)].copy()

fig = px.scatter(
    batsmen_df,
    x='Total Runs Scored',
    y='Sold Price (Rs)',
    color='Team',
    hover_data=['player_name', 'Cost Per Run'],
    title='Batsmen Value Map: Runs vs. Auction Price',
    template='plotly_white'
)

fig.add_annotation(
    text='Bottom-Right: High Output, Low Cost (Hidden Gems)',
    xref='paper', yref='paper',
    x=0.98, y=0.02,
    showarrow=False, align='right',
    font=dict(size=12, color='gray')
)

fig.show()